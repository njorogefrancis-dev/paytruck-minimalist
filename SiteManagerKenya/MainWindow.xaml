<Window x:Class="SiteManagerKenya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SiteManager Kenya" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D1D5DB"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="16,12">
            <TextBlock Text="SiteManager Kenya" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <TabControl Margin="12" Background="Transparent" BorderThickness="0">

            <!-- ===================== CLOCK IN / OUT ===================== -->
            <TabItem Header="Clock In / Out" DataContext="{Binding Clock}">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Clock In / Out" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Worker:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" MinWidth="280" MaxWidth="320" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Workers}"
                                      SelectedItem="{Binding SelectedWorker}"
                                      DisplayMemberPath="FullName">
                                <ComboBox.ToolTip>
                                    <TextBlock Text="No workers yet? Add one on the Workers tab first."/>
                                </ComboBox.ToolTip>
                            </ComboBox>
                            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Clock In" Command="{Binding ClockInCommand}" Margin="0,0,10,0" Background="#16A34A"/>
                            <Button Content="Clock Out" Command="{Binding ClockOutCommand}" Background="#DC2626"/>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#374151">
                            <Run Text="Hours worked this month: "/>
                            <Run Text="{Binding HoursWorkedThisMonth, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBlock Text="Loading..." Margin="0,10,0,0" FontStyle="Italic" Foreground="#6B7280"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===================== PAYROLL ===================== -->
            <TabItem Header="Payroll" DataContext="{Binding Payroll}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Calculate Payroll" Style="{StaticResource SectionHeader}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="80" Text="{Binding SelectedYear}" Margin="0,0,16,0"/>
                                <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="60" Text="{Binding SelectedMonth}" Margin="0,0,16,0"/>
                                <Button Content="Calculate" Command="{Binding CalculateCommand}"/>
                            </StackPanel>
                            <TextBlock>
                                <Run Text="{Binding PeriodLabel, Mode=OneWay}" FontWeight="Bold"/>
                                <LineBreak/>
                                <Run Text="{Binding StatusMessage, Mode=OneWay}" Foreground="#374151"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1">
                        <DataGrid ItemsSource="{Binding PayrollEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Worker ID" Binding="{Binding WorkerId}"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding WorkerName}"/>
                                <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyRate}"/>
                                <DataGridTextColumn Header="Hours Worked" Binding="{Binding HoursWorked}"/>
                                <DataGridTextColumn Header="Gross Earnings" Binding="{Binding GrossEarnings}"/>
                                <DataGridTextColumn Header="Total Paid" Binding="{Binding TotalPaid}"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== WORKERS ===================== -->
            <TabItem Header="Workers" DataContext="{Binding Workers}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add Worker form -->
                    <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Add Worker" Style="{StaticResource SectionHeader}"/>
                            <UniformGrid Columns="3" Rows="2">
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="Full Name *" Margin="0,0,0,4" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding NewWorkerFullName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="National ID *" Margin="0,0,0,4" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding NewWorkerNationalId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Phone Number" Margin="0,0,0,4" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding NewWorkerPhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Category" Margin="0,0,0,4" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding NewWorkerCategory, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Job Role" Margin="0,0,0,4" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding NewWorkerJobRole, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Daily Wage Rate *" Margin="0,0,0,4" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding NewWorkerDailyWageRate, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="Add Worker" Command="{Binding AddWorkerCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Background="#16A34A"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#374151" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Search bar -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                        <TextBox Width="260" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                        <Button Content="Reload" Command="{Binding LoadWorkersCommand}" Margin="8,0,0,0" Background="#6B7280"/>
                    </StackPanel>

                    <!-- Worker list -->
                    <Border Style="{StaticResource Card}" Grid.Row="2" Padding="0">
                        <DataGrid ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Worker ID" Binding="{Binding WorkerId}"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding WorkerCategory}"/>
                                <DataGridTextColumn Header="Job Role" Binding="{Binding JobRole}"/>
                                <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyWageRate}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" Background="#6B7280"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Page "/>
                            <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Content="Next" Command="{Binding NextPageCommand}" Margin="8,0,0,0" Background="#6B7280"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
